{
    "name": "tp/ci-cd-library",
    "description": "Simple library management system",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Library\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs src/ --standard=PSR12",
        "analyse": "phpstan analyse src/ --level=5"
    }
}