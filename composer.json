{
    "name": "tp/ci-cd-library",
    "description": "Simple library management system for CI/CD demo",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Library\\": "src/"
        }
    },
    "scripts": {
        "test": "php vendor/phpunit/phpunit/phpunit",
        "test-coverage": "php vendor/phpunit/phpunit/phpunit --coverage-text",
        "lint": "@php vendor/bin/phpcs src/ --standard=PSR12",
        "analyse": "@php vendor/bin/phpstan analyse src/ --level=5"
    }
}